__pycache__/
*.py[cod]
/.local/generated/crawl/**/__pycache__/

# 旧版图标本地化缓存仅为本机生成物；当前运行时不读取该目录
/public/icons/
# 旧掘金海报缓存已无页面消费者，避免历史采集产物重新进入仓库
/src/data/juejinImg/
