{
  "manifest_version": 3,
  "name": "LPTFF 本地助手",
  "version": "3.24.0",
  "description": "本机授权采集：支持基金与币安合约来源采集、BOSS 求职助手、指定内容来源采集和共享 Gemini 配置。登录态留在来源页面，结果仅保存在本机。",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "tabs",
    "storage",
    "notifications",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://fund.eastmoney.com/*",
    "https://fundf10.eastmoney.com/*",
    "https://api.fund.eastmoney.com/*",
    "https://*.binance.com/*",
    "https://*.zhipin.com/*",
    "https://zhipin.com/*",
    "https://www.douyin.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "eastmoney_referer",
        "enabled": true,
        "path": "rules/eastmoney-referer.json"
      },
      {
        "id": "boss_devtools",
        "enabled": true,
        "path": "rules/boss-devtools.json"
      }
    ]
  },
  "action": {
    "default_title": "LPTFF 本地助手",
    "default_popup": "popup/shell.html"
  },

  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "boss.js"
      ],
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": ["content/boss-devtools-shield.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": [
        "content/network-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://lptff.github.io/*"
      ],
      "js": [
        "content/web-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": [
        "content/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/boss-feature-bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
