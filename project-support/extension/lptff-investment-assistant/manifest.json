{
  "manifest_version": 3,
  "name": "LPTFF Investment Assistant",
  "version": "3.17.8",
  "description": "多领域正式来源采集：基金、币安 U 本位合约全量历史、BOSS直聘职位、快手视频、抖音兴趣视频数据集、红果短剧清单。认证信息仅在来源页内存中临时复用。",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "tabs",
    "storage",
    "notifications",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://fund.eastmoney.com/*",
    "https://fundf10.eastmoney.com/*",
    "https://api.fund.eastmoney.com/*",
    "https://*.binance.com/*",
    "https://*.zhipin.com/*",
    "https://zhipin.com/*",
    "https://www.kuaishou.com/*",
    "https://www.douyin.com/*",
    "https://hongguoduanju.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "eastmoney_referer",
        "enabled": true,
        "path": "rules/eastmoney-referer.json"
      }
    ]
  },
  "action": {
    "default_title": "LPTFF 多领域本地助手",
    "default_popup": "popup/shell.html"
  },
  "commands": {
    "generate-douyin-dataset": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "生成抖音感兴趣视频数据集"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "boss.js"
      ],
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": [
        "content/network-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/investment*",
        "http://localhost/contract-review*",
        "http://127.0.0.1/investment*",
        "http://127.0.0.1/contract-review*",
        "https://lptff.github.io/investment*",
        "https://lptff.github.io/contract-review*"
      ],
      "js": [
        "content/web-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": [
        "content/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/boss-feature-bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kuaishou.com/*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.kuaishou.com/*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hongguoduanju.com/*"
      ],
      "js": [
        "content/source-extractor.js",
        "content/observation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://hongguoduanju.com/*"
      ],
      "js": [
        "content/observation-collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
