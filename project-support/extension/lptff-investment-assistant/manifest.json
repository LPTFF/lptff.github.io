{
  "manifest_version": 3,
  "name": "LPTFF Investment Assistant",
  "version": "3.9.2",
  "description": "多领域正式来源采集：基金、币安 U 本位合约全量历史、BOSS直聘职位、快手/抖音视频清单。认证信息仅在来源页内存中临时复用。",
  "permissions": ["activeTab", "alarms", "downloads", "offscreen", "tabs", "storage", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "https://fund.eastmoney.com/*",
    "https://fundf10.eastmoney.com/*",
    "https://api.fund.eastmoney.com/*",
    "https://*.binance.com/*",
    "https://www.zhipin.com/*",
    "https://www.kuaishou.com/*",
    "https://www.douyin.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "eastmoney_referer",
        "enabled": true,
        "path": "rules/eastmoney-referer.json"
      }
    ]
  },
  "action": {
    "default_title": "高效采集投资来源数据",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": ["content/network-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/investment*",
        "http://localhost/contract-review*",
        "http://127.0.0.1/investment*",
        "http://127.0.0.1/contract-review*",
        "https://lptff.github.io/investment*",
        "https://lptff.github.io/contract-review*"
      ],
      "js": ["content/web-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://trade.1234567.com.cn/*",
        "https://query.1234567.com.cn/*"
      ],
      "js": ["content/collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": ["content/source-extractor.js", "content/observation-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.binance.com/futures*",
        "https://www.binance.com/en/futures*",
        "https://www.binance.com/en-US/futures*",
        "https://www.binance.com/zh/futures*",
        "https://www.binance.com/zh-CN/futures*"
      ],
      "js": ["content/observation-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content/source-extractor.js", "content/observation-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content/observation-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.kuaishou.com/*"],
      "js": ["content/source-extractor.js", "content/observation-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.kuaishou.com/*"],
      "js": ["content/observation-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content/source-extractor.js", "content/observation-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content/observation-collector.js"],
      "run_at": "document_idle"
    }
  ]
}
